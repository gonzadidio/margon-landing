# Variables de entorno del panel /admin (configurar en Railway o en un .env local)

# Conexión a PostgreSQL. En Railway se inyecta sola al linkear el servicio de Postgres.
DATABASE_URL=postgresql://usuario:password@host:5432/basededatos

# Contraseña única para entrar al panel /admin
ADMIN_PASSWORD=cambiame

# Secreto para firmar los tokens de sesión (JWT). Poné una cadena larga y aleatoria.
JWT_SECRET=cambiame-por-algo-largo-y-aleatorio

# Puerto (Railway lo inyecta automáticamente; en local usa 3001 por defecto)
# PORT=3001
